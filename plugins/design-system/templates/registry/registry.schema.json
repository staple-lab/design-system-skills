{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://staple-lab.github.io/design-system-skills/registry.schema.json",
  "title": "Design system registry",
  "description": "Generated by build-registry.mjs. ONE source consumed by the inventory site, AGENTS.md, the lint rules and the adoption reports. Never hand-edit registry.json — edit the component source or its <Name>.meta.json.",
  "type": "object",
  "required": ["generated", "system", "components"],
  "properties": {
    "generated": { "type": "string", "description": "Tool that produced this file" },
    "system": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "packageName": { "type": ["string", "null"] },
        "primitives": { "type": "string" },
        "cssSystem": { "type": "string" },
        "motion": { "type": "string" }
      }
    },
    "counts": {
      "type": "object",
      "description": "Roll-up for the status board",
      "properties": {
        "total": { "type": "integer" },
        "byStatus": { "type": "object", "additionalProperties": { "type": "integer" } }
      }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["name", "status"],
      "properties": {
        "name": { "type": "string" },
        "status": {
          "enum": ["draft", "beta", "stable", "deprecated"],
          "description": "Lifecycle. A component reaching `stable` is a promise: no breaking change without a major and a migration."
        },
        "since": { "type": "string", "description": "Version it landed in" },
        "category": { "type": "string", "description": "Actions | Forms | Feedback | Layout | Navigation | Data display | Overlays | Typography" },
        "summary": { "type": "string", "description": "One line. Shown on the gallery card and in AGENTS.md." },
        "description": { "type": "string" },
        "synonyms": {
          "type": "array",
          "items": { "type": "string" },
          "description": "What people type when looking for this. Someone searching 'dropdown' must find Select. Failed search is the main reason duplicates get built."
        },
        "useFor": { "type": "array", "items": { "type": "string" } },
        "dontUseFor": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Include the alternative: 'Navigation — use Link'. A prohibition without a redirect gets ignored."
        },
        "sourcePath": { "type": "string" },
        "parts": {
          "type": "array",
          "description": "Anatomy of a compound component",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "required": { "type": "boolean" },
              "description": { "type": "string" }
            }
          }
        },
        "props": {
          "type": "array",
          "description": "AUTO-EXTRACTED from the TypeScript types. Never hand-write — a wrong props table poisons trust in all of them.",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "default": { "type": ["string", "null"] },
              "required": { "type": "boolean" },
              "description": { "type": "string" },
              "deprecated": { "type": ["string", "null"] },
              "extendsNative": { "type": ["string", "null"], "description": "e.g. 'button' when the props extend ComponentPropsWithRef<'button'>" }
            }
          }
        },
        "keyboard": {
          "type": "array",
          "description": "The most-consulted section of any good design system's docs, and the most commonly missing.",
          "items": {
            "type": "object",
            "required": ["keys", "action"],
            "properties": {
              "keys": { "type": "string" },
              "action": { "type": "string" }
            }
          }
        },
        "a11y": {
          "type": "object",
          "properties": {
            "role": { "type": "string" },
            "provides": { "type": "array", "items": { "type": "string" }, "description": "What the component handles for you" },
            "consumerMustProvide": { "type": "array", "items": { "type": "string" }, "description": "What the caller still owes — e.g. an accessible name for icon-only usage" },
            "limitations": { "type": "array", "items": { "type": "string" }, "description": "State them. A documented gap is a decision; an undocumented one is a surprise." },
            "axeStatus": { "enum": ["pass", "fail", "unknown"] }
          }
        },
        "doDont": {
          "type": "array",
          "description": "Highest-signal guidance there is: absorbed in ten seconds, prevents the misuse a paragraph of prose does not.",
          "items": {
            "type": "object",
            "required": ["do", "dont"],
            "properties": {
              "do": { "type": "string" },
              "dont": { "type": "string" },
              "why": { "type": "string" }
            }
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "code"],
            "properties": {
              "title": { "type": "string" },
              "description": { "type": "string" },
              "code": { "type": "string" }
            }
          }
        },
        "tokens": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Auto-scanned from the styles. Makes 'what breaks if I change this token' a lookup rather than a guess."
        },
        "tests": {
          "type": "object",
          "properties": {
            "total": { "type": "integer" },
            "passing": { "type": "integer" },
            "failing": { "type": "integer" },
            "coverage": { "type": ["number", "null"] },
            "hasKeyboardTests": { "type": "boolean" },
            "hasAxeTests": { "type": "boolean" }
          }
        },
        "lint": {
          "type": "object",
          "properties": { "errors": { "type": "integer" }, "warnings": { "type": "integer" } }
        },
        "bundle": {
          "type": "object",
          "properties": { "gzip": { "type": ["integer", "null"] }, "raw": { "type": ["integer", "null"] } }
        },
        "adoption": {
          "type": "object",
          "properties": {
            "usages": { "type": "integer" },
            "files": { "type": "array", "items": { "type": "string" } },
            "shadowImplementations": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Hand-rolled equivalents still in the product — the real adoption cost"
            }
          }
        },
        "deprecation": {
          "type": ["object", "null"],
          "properties": {
            "replacedBy": { "type": "string" },
            "removeIn": { "type": "string", "description": "A deprecation with no removal date is a permanent fixture" },
            "migration": { "type": "string" }
          }
        },
        "related": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
